{
  "expo": {
    "name": "fixit-mobile",
    "slug": "fixit-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fixitmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "ar.oficy.fixitmobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Oficy usa la camara para que puedas sacar fotos y videos en el chat con tu cliente o prestador.",
        "NSMicrophoneUsageDescription": "Oficy usa el microfono para que puedas grabar audios en el chat.",
        "NSPhotoLibraryUsageDescription": "Oficy usa tus fotos para que puedas adjuntar imagenes en el chat y en tus trabajos realizados.",
        "NSLocationWhenInUseUsageDescription": "Oficy usa tu ubicacion para configurar tu zona de cobertura como prestador."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.eltowi.fixitmobile",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyA8XdIR4rR6pMKGox_Z3DmaXXOFz4hQGH8"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-audio",
      "expo-video",
      "expo-notifications",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.255386234536-r49pq3ebacifsjopl7kcas366g6k82va"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5bf5a8b1-c074-43ab-99dc-070d39786df0"
      }
    },
    "owner": "eltowi"
  }
}
